<resources>
    <!--
      ICELANDIC IS THE DEFAULT RESOURCE SET, and it lives HERE in values/ —
      there must never be a values-is/ folder. Language.code "is" falls through
      to this file, which is exactly what we want; a values-is/ would create a
      second Icelandic string set that quietly drifts out of step with this one.

      Voice: lowercase throughout. Cormorant italic carries the display lines,
      Geist the body, so the copy reads as editorial rather than shouted.
    -->
    <string name="app_name">Snarl Fridge</string>

    <!-- ==== the three steps, matching the sticker on the glass door ====
         The physical sticker reads Borga / Opna / Taka. "borga" means PAY, so
         the Icelandic reads pay-open-take while the English on the same sticker
         reads tap-open-take. Match the sticker, not grammatical symmetry — the
         point is that screen and door teach the same three words. -->
    <string name="step_pay">borga</string>
    <string name="step_open">opna</string>
    <string name="step_take">taka</string>

    <!-- The idle screen narrates itself: these three cycle in step with the
         animation, so the words say what the drawing is doing at that moment.
         Same three actions as the sticker and the strip, in full sentences. -->
    <string name="idle_step1">borgaðu með korti</string>
    <string name="idle_step2">opnaðu skápinn</string>
    <string name="idle_step3">taktu það sem þú vilt</string>
    <string name="idle_sub">notaðu kort eða síma til að byrja</string>

    <string name="authorizing_title">augnablik…</string>
    <string name="authorizing_sub">staðfesti kortið þitt — ekkert er dregið af strax</string>

    <string name="unlocked_title">opnaðu hurðina</string>
    <string name="unlocked_sub">hurðin er ólæst — taktu það sem þig vantar</string>

    <string name="shopping_title">karfan þín</string>
    <string name="shopping_sub">uppfærist eftir því sem þú tekur</string>
    <string name="shopping_hint">lokaðu hurðinni til að ljúka</string>
    <!-- Door open, nothing taken yet: an invitation, not an empty grid. -->
    <string name="shopping_empty">taktu það sem\nþig vantar</string>

    <string name="door_warn">lokaðu hurðinni — hún er enn opin</string>

    <string name="calculating_title">reikna…</string>
    <string name="calculating_sub">vigta körfurnar og reikna upphæðina</string>

    <!-- No "estimated/áætlað" qualifier anywhere: the figure genuinely is what
         gets charged, and hedging it invites doubt about a correct amount. -->
    <string name="receipt_title">takk fyrir</string>
