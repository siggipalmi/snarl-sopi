    <string name="total_label">samtals</string>
    <string name="amount_isk">%1$d kr</string>
    <string name="quantity_badge">×%1$d</string>
    <!-- Prominent bronze banner. Matters because the weight-stability fallback
         can settle with the door still standing open. -->
    <string name="close_door_firmly">lokaðu hurðinni vel</string>

    <string name="nothing_taken_title">ekkert tekið</string>
