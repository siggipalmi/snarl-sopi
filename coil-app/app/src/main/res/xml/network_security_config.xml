<?xml version="1.0" encoding="utf-8"?>
<!--
    Allow plaintext HTTP only for the Weimi test endpoint.
    Production endpoint (micron.weimi24.com) is HTTPS and uses platform defaults.
    Remove this file once we move fully to production.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">api.weimi24.com</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
