# Copy to local.properties and fill in. local.properties is gitignored and must stay that way:
# app/build.gradle.kts reads TEST_MACHINE_KEY from here and bakes it into the build, so a
# committed copy publishes a live machine key. One did, for six weeks, in a public repo.
#
# Android Studio writes sdk.dir itself on first sync.
sdk.dir=/Users/<you>/Library/Android/sdk

# Only needed while the coil app still takes its identity from the build. Once it provisions
# itself against POST /api/v1/machines/provision this should be empty on every machine.
# Issue a key from the dashboard; revoke it when done. Never paste one into chat or a commit.
TEST_MACHINE_KEY=
TEST_MACHINE_DEVICE_CODE=
